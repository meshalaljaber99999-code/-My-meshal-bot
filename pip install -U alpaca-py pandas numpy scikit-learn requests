def db_connect():
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    return conn


def init_database() -> None:
    with db_connect() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS events (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                ts_utc TEXT NOT NULL,
                category TEXT NOT NULL,
                symbol TEXT,
                reason TEXT,
                details_json TEXT
            )
        """)

        conn.execute("""
            CREATE TABLE IF NOT EXISTS bot_orders (
                order_id TEXT PRIMARY KEY,
                client_order_id TEXT,
                symbol TEXT NOT NULL,
                underlying TEXT,
                side TEXT,
                qty INTEGER,
                submitted_at TEXT NOT NULL,
                status TEXT,
                filled_qty REAL DEFAULT 0,
                avg_fill_price REAL,
                note TEXT
            )
        """)

        conn.execute("""
            CREATE TABLE IF NOT EXISTS bot_trades (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                option_symbol TEXT NOT NULL,
                underlying TEXT NOT NULL,
                side TEXT NOT NULL,
                qty INTEGER NOT NULL,
                entry_price REAL NOT NULL,
                entry_time TEXT NOT NULL,
                exit_price REAL,
                exit_time TEXT,
                exit_reason TEXT,
                realized_pnl REAL
            )
        """)

        conn.execute("""
            CREATE TABLE IF NOT EXISTS symbol_cooldowns (
                symbol TEXT PRIMARY KEY,
                last_entry_utc TEXT NOT NULL
            )
        """)


def record_event(
    category: str,
    symbol: Optional[str] = None,
    reason: str = "",
    details: Optional[dict] = None,
) -> None:
    try:
        with db_connect() as conn:
            conn.execute(
                """
                INSERT INTO events
                (ts_utc, category, symbol, reason, details_json)
                VALUES (?, ?, ?, ?, ?)
                """,
                (
                    utc_now().isoformat(),
                    category,
                    symbol,
                    reason,
                    json.dumps(details or {}, default=str),
                ),
            )
    except Exception as exc:
        log(f"DB EVENT ERROR | {exc}", "error")


def record_order(
    order_id: str,
    client_order_id: str,
    symbol: str,
    underlying: str,
    side: str,
    qty: int,
    status: str,
    filled_qty: float = 0,
    avg_fill_price: Optional[float] = None,
    note: str = "",
) -> None:
    try:
        with db_connect() as conn:
            conn.execute(
                """
                INSERT INTO bot_orders (
                    order_id, client_order_id, symbol, underlying,
                    side, qty, submitted_at, status, filled_qty,
                    avg_fill_price, note
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(order_id) DO UPDATE SET
                    status=excluded.status,
                    filled_qty=excluded.filled_qty,
                    avg_fill_price=excluded.avg_fill_price,
                    note=excluded.note
                """,
                (
                    order_id,
                    client_order_id,
                    symbol,
                    underlying,
                    side,
                    qty,
                    utc_now().isoformat(),
                    status,
                    filled_qty,
                    avg_fill_price,
                    note,
                ),
            )
    except Exception as exc:
        log(f"DB ORDER ERROR | {exc}", "error")


